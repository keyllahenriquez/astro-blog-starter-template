---
const today = new Date();
---

<footer style="background-color: #1a1a1a; color: #f0f0f0; padding: 3.5rem 1.5rem; text-align: center; margin-top: 4rem;">
	<div style="max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.2rem;">
		
		<!-- Logotipo de Habitarme -->
		<img 
			src="/logo KH 1200X300 v4.jpg" 
			alt="Logo Habitarme" 
			style="max-width: 180px; height: auto; filter: brightness(0) invert(1);" 
		/>

		<!-- Subtítulo del blog -->
		<p style="font-family: 'Josefin Sans', sans-serif; font-size: 0.95rem; font-weight: 300; color: #cccccc; margin: 0; letter-spacing: 0.05em;">
			Un espacio para ser, sentir y soltar.
		</p>

		<!-- Derechos de autor -->
		<p style="font-family: 'Josefin Sans', sans-serif; font-size: 0.85rem; color: #888888; margin-top: 1rem;">
			&copy; {today.getFullYear()} HABITARME. Todos los derechos reservados.
		</p>
	</div>
</footer>
