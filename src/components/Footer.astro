---
const today = new Date();
---

<footer style="width: 100%; background-color: #161616; color: #f0f0f0; padding: 4rem 0; text-align: center; margin-top: 5rem; box-sizing: border-box;">
	<div style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 1.8rem;">
		
		<!-- 1. LOGOTIPO (Lo primero que se visualiza) -->
		<img 
			src="/logo.png" 
			alt="Logo Keylla Henríquez" 
			style="width: 240px; max-width: 100%; height: auto; display: block; margin: 0 auto;" 
		/>

		<!-- 2. MENSAJE Y LINKS DE CONTACTO -->
		<div style="font-family: 'Josefin Sans', sans-serif; font-size: 1rem; font-weight: 300; color: #dddddd; line-height: 1.8;">
			<p style="margin: 0 0 0.5rem 0;"<Comunícate conmigo:</p>
			
			<div style="display: flex; justify-content: center; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
				<!-- www.keyllahenriquez@gmail.com -->
				<a href="mailto:tu-correo@email.com" style="color: #ffffff; text-decoration: underline; text-underline-offset: 4px; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
					keyllahenriquez@gmail.com
				</a>
				
				<span style="color: #666666;">|</span>

				<!-- https://www.instagram.com/keyllahenriquez/ -->
				<a href="https://instagram.com/tu_usuario" target="_blank" rel="noopener noreferrer" style="color: #ffffff; text-decoration: underline; text-underline-offset: 4px; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
					https://www.instagram.com/keyllahenriquez/
				</a>
			</div>
		</div>

		<!-- 3. DERECHOS DE AUTOR -->
		<p style="font-family: 'Josefin Sans', sans-serif; font-size: 0.85rem; color: #777777; margin-top: 1rem; letter-spacing: 0.05em;">
			&copy; {today.getFullYear()} HABITARME. Todos los derechos reservados.
		</p>
	</div>
</footer>
