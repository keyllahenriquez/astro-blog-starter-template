---
const today = new Date();
---

<footer style="background-color: #fafafa; color: #2d2d2d; padding: 3rem 1.5rem; text-align: center; border-top: 1px solid #eaeaea; margin-top: 4rem;">
	<div style="max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.2rem;">
		
		<!-- Logotipo en color original -->
		<img 
			src="/transparente 18.png" 
			alt="Logo Habitarme" 
			style="max-width: 180px; height: auto;" 
		/>

		<!-- Derechos de autor -->
		<p style="font-family: 'Josefin Sans', sans-serif; font-size: 0.85rem; color: #777777; margin-top: 0.5rem;">
			&copy; {today.getFullYear()} HABITARME. Todos los derechos reservados.
		</p>
	</div>
</footer>
