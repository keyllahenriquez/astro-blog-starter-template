---
const today = new Date();
---

<footer style="background-color: #161616; color: #f0f0f0; padding: 4.5rem 1.5rem; text-align: center; margin-top: 5rem;">
	<div style="max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.5rem;">
		
		<!-- LOGOTIPO EN FONDO OSCURO -->
		<img 
			src="/logo1200x400v4.jpg" 
			alt="Logo Keylla Henríquez" 
			style="width: 240px; max-width: 100%; height: auto; display: block; margin: 0 auto;" 
		/>

		<!-- FRASE / SUBTÍTULO OPCIONAL -->
		<p style="font-family: 'Josefin Sans', sans-serif; font-size: 0.95rem; font-weight: 300; color: #aaaaaa; margin: 0; letter-spacing: 0.1em;">
			Un espacio para ser, sentir y soltar.
		</p>

		<!-- DERECHOS DE AUTOR -->
		<p style="font-family: 'Josefin Sans', sans-serif; font-size: 0.85rem; color: #777777; margin-top: 1rem; letter-spacing: 0.05em;">
			&copy; {today.getFullYear()} HABITARME. Todos los derechos reservados.
		</p>
	</div>
</footer>
