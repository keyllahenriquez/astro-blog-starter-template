---
const today = new Date();
---

<footer style="background-color: #fafafa; color: #2d2d2d; padding: 4rem 1.5rem; text-align: center; border-top: 1px solid #eaeaea; margin-top: 4rem;">
	<div style="max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.5rem;">
		
		<!-- LOGOTIPO AMPLIADO -->
		<img 
		    src="/logo.png" 
		    alt="Logo Habitarme" 
		    style="width: 220px; height: auto; display: block; margin: 0 auto;" 
		/>

		<!-- DERECHOS DE AUTOR -->
		<p style="font-family: 'Josefin Sans', sans-serif; font-size: 0.9rem; color: #666666; margin: 0; letter-spacing: 0.05em;">
			&copy; {today.getFullYear()} HABITARME. Todos los derechos reservados.
		</p>
	</div>
</footer>
