---
import HeaderLink from './HeaderLink.astro';
---

<header style="background-color: #000000; padding: 0.5rem 1.5rem; position: sticky; top: 0; z-index: 100;">
	<nav style="display: flex; flex-direction: column; align-items: center; max-width: 960px; margin: 0 auto; gap: 0.5rem;">
		
		<!-- Tu logotipo en grande, legible y centrado ocupando la tira horizontal -->
		<a href="/" style="display: block; width: 100%; max-width: 500px; text-align: center;">
			<img src="/banner 1200x400 v1.jpg" alt="Logo HABITARME" style="width: 100%; height: auto; display: block; margin: 0 auto;" />
		</a>

		<!-- Enlaces blancos debajo del logotipo -->
		<div style="display: flex; gap: 2.5rem; margin-top: 0.25rem;">
			<a href="/" style="color: #ffffff; text-decoration: none; font-weight: 500; font-size: 1rem; letter-spacing: 0.05em;">Inicio</a>
			<a href="/blog" style="color: #ffffff; text-decoration: none; font-weight: 500; font-size: 1rem; letter-spacing: 0.05em;">Blog</a>
		</div>

	</nav>
</header>

