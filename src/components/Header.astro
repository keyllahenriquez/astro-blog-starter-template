
---
---

<header class="site-header">
  <nav class="site-nav">
    <a class="site-logo" href="/" aria-label="HABITARME - Inicio">
      <img
        src="/banner%201200x400%20v1.jpg"
        alt="HABITARME"
      />
    </a>

    <div class="site-links">
      <a href="/">Inicio</a>
      <a href="/blog">Blog</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background-color: #000000;
    padding: 0.5rem 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .site-logo {
    display: block;
    flex: 0 1 480px;
    min-width: 0;
  }

  .site-logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2.5rem;
    flex-shrink: 0;
  }

  .site-links a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .site-links a:hover {
    color: #d8c5a5;
  }

  @media (max-width: 600px) {
    .site-header {
      padding: 0.75rem 1rem;
    }

    .site-nav {
      flex-direction: column;
      gap: 0.75rem;
    }

    .site-logo {
      flex: none;
      width: 100%;
      max-width: 420px;
    }

    .site-links {
      gap: 2rem;
    }
  }
</style>
