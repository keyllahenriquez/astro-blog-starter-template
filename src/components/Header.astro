---
import HeaderLink from './HeaderLink.astro';
---

<header style="background-color: #000000; padding: 1rem 1.5rem; position: sticky; top: 0; z-index: 100;">
	<nav style="display: flex; align-items: center; justify-content: space-between; max-width: 960px; margin: 0 auto; height: 50px;">
		
		<!-- Tu logotipo oficial cargado desde la carpeta public -->
		<a href="/" style="display: flex; align-items: center; height: 100%;">
			<img src="/banner 1200x400 v1.jpg" alt="logo" style="height: 80px; font-size: 1rem; width: auto; object-fit: contain;" />
		</a>

		<!-- Enlaces de navegación en color blanco -->
		<div style="display: flex; gap: 2rem;">
			<a href="/" style="color: #ffffff; text-decoration: none; font-weight: 500; font-size: 1rem;">Inicio</a>
			<a href="/blog" style="color: #ffffff; text-decoration: none; font-weight: 500; font-size: 1rem;">Blog</a>
		</div>

	</nav>
</header>
