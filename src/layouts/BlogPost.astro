---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import type { CollectionEntry } from 'astro:content';

type BlogProps = CollectionEntry<"blog">;
type Props = BlogProps["data"];

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title || SITE_TITLE} description={description || SITE_DESCRIPTION} />
		<style>
			.home-hero {
				position: relative;
				width: 100%;
				height: 120px;
				background-color: #000000;
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0 2rem;
				box-sizing: border-box;
			}

			.hero-nav {
				display: flex;
				gap: 2rem;
				justify-content: flex-end;
				align-items: center;
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				box-sizing: border-box;
			}

			.hero-nav a {
				color: #ffffff;
				font-family: 'Josefin Sans', sans-serif;
				font-size: 1.1rem;
				font-weight: 600;
				text-decoration: none;
				letter-spacing: 0.01em;
			}

			.hero-nav a:hover {
				opacity: 0.85;
			}

			.titulo-manuscrito {
				font-family: "Shadows Into Light", cursive !important;
				font-weight: 400 !important;
				font-size: 2.5rem !important;
				margin: 0 !important;
				color: #FFFFFF !important;
				text-decoration: none;
			}

			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
				padding: 4em 1.5em;
				box-sizing: border-box;
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 300;
				font-size: 1.15rem;
				color: #2b2b2b;
				line-height: 1.8;
				text-align: left;
			}

			.article-title {
				font-size: 2.2rem;
				margin-bottom: 1.5rem;
				color: #2b2b2b;
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 600;
			}

			footer {
				background-color: #000000 !important;
			}
		</style>
	</head>
	<body style="margin: 0; padding: 0; background-color: rgb(229, 216, 193);">
		
		<header class="home-hero">
			<a href="/" class="titulo-manuscrito">HABITARME</a>
			<nav class="hero-nav">
				<a href="/">Inicio</a>
				<a href="/blog">Blog</a>
				<a href="/about">Acerca de mí</a>
			</nav>
		</header>

		<main>
			<article>
				<h1 class="article-title">{title}</h1>
				<slot />
			</article>
		</main>

		<Footer />
	</body>
</html>
