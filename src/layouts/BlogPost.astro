---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import type { CollectionEntry } from 'astro:content';

type BlogProps = CollectionEntry<"blog">;
type Props = BlogProps["data"];

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title || SITE_TITLE} description={description || SITE_DESCRIPTION} />
		<style>
			/* CABECERA IDÉNTICA A LA DEL LISTADO DE ARTÍCULOS */
			.site-header {
				width: 100%;
				background-color: #000000;
				padding: 1.2rem 2rem;
				box-sizing: border-box;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.site-brand {
				font-family: "Shadows Into Light", cursive;
				font-size: 1.8rem;
				color: #ffffff;
				text-decoration: none;
			}

			.site-nav {
				display: flex;
				gap: 2rem;
				align-items: center;
			}

			.site-nav a {
				color: #ffffff;
				font-family: 'Josefin Sans', sans-serif;
				font-size: 1.1rem;
				font-weight: 600;
				text-decoration: none;
				letter-spacing: 0.01em;
			}

			.site-nav a:hover {
				opacity: 0.85;
			}

			/* CONTENIDO DEL ARTÍCULO */
			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
				padding: 4em 1.5em;
				box-sizing: border-box;
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 300;
				font-size: 1.15rem;
				color: #2b2b2b;
				line-height: 1.8;
				text-align: left;
			}

			.article-title {
				font-size: 2.2rem;
				margin-bottom: 1.5rem;
				color: #2b2b2b;
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 600;
			}

			/* PIE DE PÁGINA CON EL MISMO TONO DE NEGRO */
			footer {
				background-color: #000000 !important;
			}
		</style>
	</head>

	<body style="margin: 0; padding: 0; background-color: rgb(229, 216, 193);">
		
		<!-- CABECERA ESTÁNDAR REPLICADA -->
		<header class="site-header">
			<a href="/" class="site-brand">HABITARME</a>
			<nav class="site-nav">
				<a href="/">Inicio</a>
				<a href="/blog">Blog</a>
				<a href="/about">Acerca de mí</a>
			</nav>
		</header>

		<!-- CONTENIDO -->
		<main>
			<article>
				<h1 class="article-title">{title}</h1>
				<slot />
			</article>
		</main>

		<Footer />
	</body>
</html>
