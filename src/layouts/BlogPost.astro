<!-- 2. AQUÍ ASIGNAMOS QUÉ FUENTE USA CADA TEXTO -->
<style is:global>
  /* Todo el texto normal, párrafos y subtítulos usarán Josefin Sans */
  html, body, p, h2, h3, h4, h5, h6 {
    font-family: 'Josefin Sans', sans-serif;
  }

  /* Únicamente el título principal (H1) usará Tangerine en tamaño grande */
  h1 {
    font-family: 'Tangerine', serif;
    font-size: 55px; 
  }
</style>
