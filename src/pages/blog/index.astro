---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

// Obtenemos las publicaciones ordenadas por fecha
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em;
			}

			.blog-header {
				text-align: center;
				margin-bottom: 3rem;
			}

			.blog-title {
				font-family: 'Shadows Into Light', cursive;
				font-size: 3.5rem;
				color: #2b2b2b;
				margin-bottom: 0.2rem;
			}

			.blog-subtitle {
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 300;
				font-size: 1.1rem;
				color: #555555;
				letter-spacing: 0.08em;
			}

			/* Listado de entradas estilo editorial */
			.posts-list {
				list-style-type: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}

			.post-card {
				border-bottom: 1px solid rgba(0, 0, 0, 0.1);
				padding-bottom: 2rem;
				transition: transform 0.2s ease;
			}

			.post-card a {
				text-decoration: none;
				color: inherit;
				display: block;
			}

			.post-card:hover h2 {
				color: #666666;
			}

			.post-date {
				font-family: 'Josefin Sans', sans-serif;
				font-size: 0.85rem;
				color: #777777;
				letter-spacing: 0.05em;
				margin-bottom: 0.4rem;
				display: block;
			}

			.post-title {
				font-family: 'Shadows Into Light', cursive;
				font-size: 2.2rem;
				color: #2b2b2b;
				margin: 0 0 0.5rem 0;
				line-height: 1.2;
			}

			.post-description {
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 300;
				font-size: 1rem;
				color: #333333;
				line-height: 1.6;
				margin: 0;
			}
		</style>
	</head>
	<body>
		<!-- Menú superior limpio -->
		<Header />

		<main>
			<!-- 2. ENCABEZADO SOBRIO -->
			<section class="blog-header">
				<h1 class="blog-title">Bitácora</h1>
				<p class="blog-subtitle">Palabras, reflexiones y aprendizajes</p>
			</section>

			<!-- 3. LISTADO VERTICAL LIMPIO (SIN IMÁGENES) -->
			<section>
				<ul class="posts-list">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.slug}/`}>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<!-- Pie de página horizontal con logo -->
		<Footer />
	</body>
</html>
