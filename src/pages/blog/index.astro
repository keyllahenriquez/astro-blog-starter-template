---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header style="width: 100%; background-color: #161616; padding: 1.2rem 0; box-sizing: border-box;">
	<nav style="max-width: 1100px; margin: 0 auto; padding: 0 2rem; display: flex; justify-content: space-between; align-items: center;">
		<!-- Logo / Nombre a la izquierda -->
		<h2>
			<a href="/" style="font-family: 'Shadows Into Light', cursive; font-size: 2.2rem; color: #ffffff; text-decoration: none; font-weight: 400; letter-spacing: 0.05em;">
				HABITARME
			</a>
		</h2>

		<!-- Links de navegación a la derecha -->
		<div style="display: flex; gap: 1.8rem; align-items: center;">
			<HeaderLink href="/" style="color: #ffffff; font-family: 'Josefin Sans', sans-serif; font-size: 1rem; text-decoration: none; font-weight: 300;">Inicio</HeaderLink>
			<HeaderLink href="/blog" style="color: #ffffff; font-family: 'Josefin Sans', sans-serif; font-size: 1rem; text-decoration: none; font-weight: 300;">Blog</HeaderLink>
			<HeaderLink href="/about" style="color: #ffffff; font-family: 'Josefin Sans', sans-serif; font-size: 1rem; text-decoration: none; font-weight: 300;">Acerca de mí</HeaderLink>
		</div>
	</nav>
</header>
