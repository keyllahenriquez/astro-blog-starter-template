---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const rawPosts = await getCollection('blog');

// Identificamos la bienvenida de forma 100% segura
const welcomePost = rawPosts.find(p => {
	const title = p.data.title?.toLowerCase() || '';
	const id = p.id?.toLowerCase() || '';
	return title.includes('bienvenido') || title.includes('habitarme') || id.includes('bienvenido');
});

const otherPosts = rawPosts
	.filter(p => p !== welcomePost)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Colocamos la bienvenida de primera si existe
const posts = welcomePost ? [welcomePost, ...otherPosts] : otherPosts;

// Función segura para formatear la fecha a español
function formatSpanishDate(dateInput: any) {
	if (!dateInput) return '';
	const date = new Date(dateInput);
	return date.toLocaleDateString('es-ES', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
				padding: 3em 1.5em;
				box-sizing: border-box;
				min-height: calc(100vh - 200px);
			}

			.posts-list {
				list-style-type: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 3rem;
			}

			.post-card {
				border-bottom: 1px solid rgba(0, 0, 0, 0.08);
				padding-bottom: 2.5rem;
			}

			.post-card a {
				text-decoration: none;
				color: inherit;
				display: block;
			}

			.post-date {
				font-family: 'Josefin Sans', sans-serif;
				font-size: 0.85rem;
				color: #777777;
				letter-spacing: 0.05em;
				margin-bottom: 0.5rem;
				display: block;
				text-transform: capitalize;
			}

			.post-title {
				font-family: 'Shadows Into Light', cursive;
				font-size: 2rem;
				color: #2b2b2b;
				margin: 0 0 0.6rem 0;
				line-height: 1.2;
				font-weight: 400;
			}

			.post-description {
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 400;
				font-size: 1.05rem;
				color: #444444;
				line-height: 1.6;
				margin: 0;
			}
		</style>
	</head>
	<body style="margin: 0; padding: 0; background-color: rgb(229, 216, 193);">
		<Header />

		<main>
			<section>
				<ul class="posts-list">
					{
						posts.map((post) => {
							const isWelcome = post === welcomePost;
							const postSlug = post.id || post.slug;
							return (
								<li class="post-card">
									<a href={`/blog/${postSlug}/`}>
										{!isWelcome && (
											<span class="post-date">
												{formatSpanishDate(post.data.pubDate)}
											</span>
										)}
										<h2 class="post-title">{post.data.title}</h2>
										<p class="post-description">{post.data.description}</p>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>

		<Footer />
	</body>
</html>
