---
import { getEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Leemos automáticamente TU artículo original completo de bienvenida
const post = await getEntry('blog', 'de-que-trata');
const { Content } = post ? await render(post) : { Content: null };
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://googleapis.com">
		<link rel="preconnect" href="https://gstatic.com" crossorigin>
		<!-- Cargamos tus dos tipografías: Playfair Display y Plus Jakarta Sans -->
		<link href="https://googleapis.com" rel="stylesheet">
	</head>
	<body style="font-family: 'Plus Jakarta Sans', sans-serif; background-color: #fafafa; color: #2c2c2c; margin: 0; padding: 0;">
		<Header />
		
		<main style="max-width: 680px; margin: 0 auto; padding: 0 1.5rem;">
			
			<!-- BANNER PRINCIPAL REESTRUCTURADO -->
			<section style="text-align: center; padding-top: 4rem; padding-bottom: 2rem;">
				<img 
					src="/blog-placeholder-about.jpg" 
					alt="Banner Habitarme" 
					style="width: 100%; max-height: 380px; object-fit: cover; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05);"
				/>
				<h1 style="font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 600; margin-top: 2.5rem; margin-bottom: 0.5rem; color: #1a1a1a; letter-spacing: -0.02em;">
					HABITARME
				</h1>
				<p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1rem; color: #666; text-transform: uppercase; letter-spacing: 0.15em; margin-top: 0;">
					Un espacio para escribir
				</p>
				<hr style="border: none; border-top: 1px solid #eaeaea; width: 80px; margin: 2rem auto;" />
			</section>

			<!-- TU TEXTO HERMOSO -->
			<article style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; line-height: 1.9; color: #2d2d2d; letter-spacing: -0.01em; padding-bottom: 5rem;">
				{Content ? <Content /> : <p>Cargando bienvenida...</p>}
			</article>

		</main>

		<Footer />
	</body>
</html>
