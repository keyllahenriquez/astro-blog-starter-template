---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getEntry, render } from 'astro:content';

const post = await getEntry('blog', 'de-que-trata');
const { Content } = post ? await render(post) : { Content: null };
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body style="background-color: #fafafa; color: #2c2c2c; margin: 0; padding: 0;">
		<main style="margin: 0; padding: 0; width: 100%;">
			
			<!-- BANNER PRINCIPAL DE BORDE A BORDE -->
			<section style="position: relative; width: 100%; height: 470px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; overflow: hidden; margin: 0; padding: 0;">
				<img 
					src="/blog-placeholder-about.jpg" 
					alt="Banner Habitarme" 
					style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
				/>
				
				<!-- Menú de navegación superior sobre la imagen de inicio -->
				<nav style="display: flex; gap: 1.8rem; justify-content: flex-end; align-items: center; width: 100%; max-width: 1100px; margin: 0 auto; padding: 1.5rem 2rem; box-sizing: border-box; position: relative; z-index: 10;">
				    <a href="/" style="color: #ffffff; font-family: 'Josefin Sans', sans-serif; font-size: 1rem; text-decoration: none; font-weight: 300; letter-spacing: 0.03em; text-shadow: 0px 1px 3px rgba(0,0,0,0.6);">Inicio</a>
				    <a href="/blog" style="color: #ffffff; font-family: 'Josefin Sans', sans-serif; font-size: 1rem; text-decoration: none; font-weight: 300; letter-spacing: 0.03em; text-shadow: 0px 1px 3px rgba(0,0,0,0.6);">Blog</a>
				    <a href="/about" style="color: #ffffff; font-family: 'Josefin Sans', sans-serif; font-size: 1rem; text-decoration: none; font-weight: 300; letter-spacing: 0.03em; text-shadow: 0px 1px 3px rgba(0,0,0,0.6);">Acerca de mí</a>
				</nav>

				<!-- TEXTOS DEL BANNER -->
				<div style="position: relative; z-index: 2; padding: 0 1.5rem; margin-top: 2rem;">
				<h1 class="titulo-manuscrito">HABITARME</h1>
				<div class="subtitulo-limpio">
					<h4>UN ESPACIO PARA SER, SENTIR Y SOLTAR</h4>
				</div>

				</div>
			</section>

			<!-- ESPACIO DE LECTURA -->
			<div style="max-width: 680px; margin: 0 auto; padding: 5rem 1.5rem 6rem 1.5rem;">
				<article style="font-family: 'Josefin Sans', sans-serif; font-size: 1.50rem; line-height: 1.9; color: #2d2d2d;">
					{Content ? <Content /> : <p>Cargando bienvenida...</p>}
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>
