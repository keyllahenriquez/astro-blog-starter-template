---
import { getEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const post = await getEntry('blog', 'de-que-trata');
const { Content } = post ? await render(post) : { Content: null };
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body style="background-color: #fafafa; color: #2c2c2c;">
		
		<main>
			<section style="position: relative; width: 100%; height: 460px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; overflow: hidden; margin: 0; padding: 0;">
				<img 
					src="/blog-placeholder-about.jpg" 
					alt="Banner Habitarme" 
					style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"
				/>
				
				<nav style="position: absolute; top: 2rem; right: 3rem; z-index: 3; display: flex; gap: 2.5rem;">
					<a href="/" class="menu-link" style="color: #FEFBF1; text-decoration: none; font-size: 0.9rem; font-weight: 500; letter-spacing: 0.05em; text-shadow: 0px 2px 4px rgba(0,0,0,0.6);">Inicio</a>
					<a href="/blog" class="menu-link" style="color: #FEFBF1; text-decoration: none; font-size: 0.9rem; font-weight: 500; letter-spacing: 0.05em; text-shadow: 0px 2px 4px rgba(0,0,0,0.6);">Blog</a>
					<a href="/acerca-de-mi" class="menu-link" style="color: #FEFBF1; text-decoration: none; font-size: 0.9rem; font-weight: 500; letter-spacing: 0.05em; text-shadow: 0px 2px 4px rgba(0,0,0,0.6);">Acerca de mí</a>
				</nav>

				<div style="position: relative; z-index: 3; padding: 0 1.5rem; margin-top: 2rem;">
					<h1 class="titulo-banner" style="font-size: 6.5rem; font-weight: 600; margin: 0; color: #FEFBF1; letter-spacing: 0.02em; text-shadow: 0px 2px 8px rgba(0,0,0,0.5); line-height: 1;">
						HABITARME
					</h1>
					<p class="subtitulo-banner" style="font-size: 0.95rem; font-weight: 500; margin-top: 1rem; margin-bottom: 0; letter-spacing: 0.28em; color: #FDF2DB; text-shadow: 0px 2px 6px rgba(0,0,0,0.6);">
						UN ESPACIO PARA PENSAR, SENTIR Y SER
					</p>
				</div>
			</section>

			<div style="max-width: 680px; margin: 0 auto; padding: 5rem 1.5rem 6rem 1.5rem;">
				<article style="font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; line-height: 1.9; color: #2d2d2d; letter-spacing: -0.01em;">
					{Content ? <Content /> : <p>Cargando bienvenida...</p>}
				</article>
			</div>
		</main>

		<Footer />
	</body>
</html>
