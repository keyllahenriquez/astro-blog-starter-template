---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getEntry, render } from 'astro:content';

const post = await getEntry('blog', 'de-que-trata');
const { Content } = post ? await render(post) : { Content: null };
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home-hero {
				position: relative;
				width: 100%;
				height: 450px;
				background-image: url('/blog-placeholder-about.jpg');
				background-size: cover;
				background-position: center;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				box-sizing: border-box;
			}

			.home-hero::after {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: rgba(0, 0, 0, 0.25);
				z-index: 1;
			}

			.hero-nav {
				position: relative;
				z-index: 2;
				display: flex;
				gap: 2rem;
				justify-content: flex-end;
				align-items: center;
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
				padding: 1.5rem 2rem;
				box-sizing: border-box;
			}

			.hero-nav a {
				color: #ffffff;
				font-family: 'Josefin Sans', sans-serif;
				font-size: 1rem;
				font-weight: 400;
				text-decoration: none;
				letter-spacing: 0.01em;
				text-shadow: 0px 1px 4px rgba(0, 0, 0, 0.8);
			}

			.hero-nav a:hover {
				opacity: 0.85;
			}

			.hero-content {
				position: relative;
				z-index: 2;
				text-align: center;
				padding: 0 1.5rem;
				margin-bottom: auto;
				margin-top: 1rem;
			}

			.titulo-manuscrito {
				font-family: "Shadows Into Light", cursive !important;
				font-weight: 400 !important;
				font-size: 4.5rem !important;
				margin: 0 !important;
				color: #ffffff !important;
				text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.5) !important;
			}

			.subtitulo-limpio h4 {
				font-family: "Josefin Sans", sans-serif !important;
				font-weight: 300 !important;
				font-size: 0.95rem !important;
				color: #ffffff !important;
				text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.5) !important;
				letter-spacing: 0.1em !important;
				margin-top: 0.4rem !important;
			}

			main {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
				padding: 4em 1.5em;
				box-sizing: border-box;
				font-family: 'Josefin Sans', sans-serif;
				font-weight: 300;
				font-size: 1.1rem;
				color: #2b2b2b;
				line-height: 1.8;
				text-align: left;
			}
		</style>
	</head>
	<body style="margin: 0; padding: 0; background-color: rgb(229, 216, 193);">
		
		<header class="home-hero">
			<nav class="hero-nav">
				<a href="/">Inicio</a>
				<a href="/blog">Blog</a>
				<a href="/about">Acerca de mí</a>
			</nav>

			<div class="hero-content">
				<h1 class="titulo-manuscrito">HABITARME</h1>
				<div class="subtitulo-limpio">
					<h4>UN ESPACIO PARA SER, SENTIR Y SOLTAR</h4>
				</div>
			</div>
			
			<div></div>
		</header>

		<main>
			{Content ? <Content /> : <p>Cargando contenido...</p>}
		</main>

		<Footer />
	</body>
</html>
